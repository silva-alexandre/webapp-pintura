{% extends 'base.html.twig' %}

{% block title %}Servico index{% endblock %}

{% block body %}
    <h1>Servico index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Tipo</th>
                <th>Detalhe</th>
                <th>Preco</th>
                <th>Foto</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for servico in servicos %}
            <tr>
                <td>{{ servico.id }}</td>
                <td>{{ servico.tipo }}</td>
                <td>{{ servico.detalhe }}</td>
                <td>{{ servico.preco }}</td>
                <td>{{ servico.foto ? servico.foto|json_encode : '' }}</td>
                <td>
                    <a href="{{ path('app_servico_show', {'id': servico.id}) }}">show</a>
                    <a href="{{ path('app_servico_edit', {'id': servico.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_servico_new') }}">Create new</a>
{% endblock %}
